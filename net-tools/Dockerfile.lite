# =============================================================================
# vpackets/net-tools:lite  —  trimmed lab host (~250-300 MB vs ~660 MB full)
# Build:
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f Dockerfile.lite -t vpackets/net-tools:lite --push .
#
# Drops the pyATS/Genie test framework + pandas/matplotlib/ipython (data/plot).
# Add any of them back inside a running container (venv is on PATH):
#   pip install pyats genie pandas ipython "scapy[all]"
# See README-LITE.md for the full rationale and measured sizes.
# =============================================================================
FROM ubuntu:24.04

# TARGETARCH is auto-populated by `docker buildx` (amd64 / arm64).
ARG TARGETARCH

LABEL maintainer="nicmcl@cisco.com"
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# =============================================================================
# 1. Core Networking & Troubleshooting Toolbox (CCIE / SP)
# =============================================================================
# --no-install-recommends is the single biggest apt saver vs. the full image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ansible-core \
    bridge-utils \
    ca-certificates \
    conntrack \
    curl \
    dnsutils \
    ethtool \
    fping \
    hping3 \
    htop \
    iftop \
    ipcalc \
    iperf3 \
    iproute2 \
    iputils-arping \
    iputils-ping \
    iputils-tracepath \
    jq \
    lldpd \
    mtr-tiny \
    ndisc6 \
    net-tools \
    netcat-openbsd \
    ngrep \
    nmap \
    openssh-client \
    openssh-server \
    python3 \
    python3-pip \
    python3-venv \
    socat \
    sudo \
    tcpdump \
    tmux \
    traceroute \
    tshark \
    unzip \
    vim-tiny \
    wget \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* /usr/share/info/*

# =============================================================================
# 1b. AI Fabric tooling — RDMA / RoCE, SRv6, PTP, NIC inspection (MRC study)
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    ibverbs-utils \
    infiniband-diags \
    kmod \
    linuxptp \
    lldpad \
    numactl \
    pciutils \
    perftest \
    rdma-core \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* /usr/share/info/*

# =============================================================================
# 2. Lean Python Automation, Telemetry & Parsing (venv — PEP 668)
# =============================================================================
ENV PATH="/opt/venv/bin:$PATH"

RUN python3 -m venv /opt/venv && \
    pip3 install --no-cache-dir \
    netmiko \
    napalm \
    nornir \
    nornir-netmiko \
    nornir-utils \
    paramiko \
    ansible-pylibssh \
    ncclient \
    scapy \
    exabgp \
    pygnmi \
    grpcio \
    protobuf \
    textfsm \
    ntc-templates \
    ttp \
    ttp-templates \
    ciscoconfparse2 \
    netaddr \
    jmespath \
    xmltodict \
    tabulate \
    rich \
    pyyaml \
    requests \
    httpx

# =============================================================================
# 2b. gnmic — OpenConfig gNMI client (telemetry subscribe / SP streaming)
# =============================================================================
RUN bash -c "$(curl -sL https://get-gnmic.openconfig.net)"

# =============================================================================
# 3. SSH Runtime Directory
# =============================================================================
RUN mkdir -p /run/sshd

# =============================================================================
# 4. Users (cisco and admin for VS Code compatibility)
# =============================================================================
RUN useradd -m -s /bin/bash cisco && echo "cisco:cisco123" | chpasswd && usermod -aG sudo cisco \
 && useradd -m -s /bin/bash admin && echo "admin:cisco123" | chpasswd && usermod -aG sudo admin

# =============================================================================
# 5. Passwordless Sudo (Essential for lab speed)
# =============================================================================
RUN echo "cisco ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/cisco \
 && echo "admin ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/admin \
 && chmod 0440 /etc/sudoers.d/cisco \
 && chmod 0440 /etc/sudoers.d/admin

# =============================================================================
# 6. SSH Hardening for Lab Environments
# =============================================================================
RUN sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
 && sed -i 's/^#\?PermitRootLogin .*/PermitRootLogin no/' /etc/ssh/sshd_config

# =============================================================================
# 7. Start Environment
# =============================================================================
WORKDIR /home/admin
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
