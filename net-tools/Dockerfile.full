# =============================================================================
# vpackets/net-tools:full  —  batteries-included lab host
# Build:
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f Dockerfile.full -t vpackets/net-tools:full -t vpackets/net-tools:latest --push .
# =============================================================================
FROM ubuntu:24.04

# TARGETARCH is auto-populated by `docker buildx` (amd64 / arm64) so the
# gnmic install below resolves the right binary on multi-platform builds.
ARG TARGETARCH

LABEL maintainer="nicmcl@cisco.com"
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# =============================================================================
# 1. Full Networking Stack, Troubleshooting, & Automation Tools (CCIE / SP)
# =============================================================================
RUN apt-get update && apt-get install -y \
    ansible \
    bind9-host \
    bridge-utils \
    ca-certificates \
    conntrack \
    curl \
    dnsutils \
    ethtool \
    fping \
    hping3 \
    htop \
    httpie \
    iftop \
    ipcalc \
    iperf3 \
    iproute2 \
    iputils-arping \
    iputils-ping \
    iputils-tracepath \
    jq \
    lldpd \
    man-db \
    mtr-tiny \
    ndisc6 \
    net-tools \
    netcat-openbsd \
    neovim \
    ngrep \
    nmap \
    openssh-client \
    openssh-server \
    python3 \
    python3-pip \
    python3-venv \
    screen \
    siege \
    socat \
    sudo \
    tcpdump \
    tcptraceroute \
    telnet \
    tmux \
    traceroute \
    tree \
    tshark \
    unzip \
    wget \
    whois \
    wrk \
    zip \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# =============================================================================
# 1b. AI Fabric tooling — RDMA / RoCE, SRv6, multipath, PTP, NIC inspection
# =============================================================================
# These cover the building blocks behind OpenAI/NVIDIA/Broadcom/Intel "MRC"
# (Multipath Reliable Connection): RoCEv2/RDMA transport, SRv6 source routing
# (iproute2 seg6), ECMP/packet-spraying, PTP time-sync, and DCB/PFC for
# lossless Ethernet. See README.md for the lab use cases.
RUN apt-get update && apt-get install -y \
    bmon \
    ibverbs-utils \
    infiniband-diags \
    iptraf-ng \
    kmod \
    linuxptp \
    lldpad \
    nload \
    numactl \
    pciutils \
    perftest \
    rdma-core \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# =============================================================================
# 2. Python Automation, Telemetry & Parsing (venv — Ubuntu 24.04 PEP 668)
# =============================================================================
# Add the virtual environment to the global PATH so commands work globally
ENV PATH="/opt/venv/bin:$PATH"

RUN python3 -m venv /opt/venv && \
    pip3 install --no-cache-dir \
    netmiko \
    napalm \
    nornir \
    nornir-netmiko \
    nornir-utils \
    paramiko \
    ansible-pylibssh \
    pyntc \
    ncclient \
    "scapy[all]" \
    exabgp \
    pygnmi \
    grpcio \
    protobuf \
    textfsm \
    ntc-templates \
    ttp \
    ttp-templates \
    ciscoconfparse2 \
    pyats \
    genie \
    netaddr \
    jmespath \
    xmltodict \
    pandas \
    tabulate \
    rich \
    ipython \
    pyyaml \
    requests \
    httpx

# =============================================================================
# 2b. gnmic — OpenConfig gNMI client (telemetry subscribe / SP streaming)
# =============================================================================
# The upstream installer auto-detects CPU architecture, so it works for both
# linux/amd64 and linux/arm64 buildx targets.
RUN bash -c "$(curl -sL https://get-gnmic.openconfig.net)"

# =============================================================================
# 3. SSH Runtime Directory
# =============================================================================
RUN mkdir -p /run/sshd

# =============================================================================
# 4. Users (cisco and admin for VS Code compatibility)
# =============================================================================
RUN useradd -m -s /bin/bash cisco && echo "cisco:cisco123" | chpasswd && usermod -aG sudo cisco \
 && useradd -m -s /bin/bash admin && echo "admin:cisco123" | chpasswd && usermod -aG sudo admin

# =============================================================================
# 5. Passwordless Sudo (Essential for lab speed)
# =============================================================================
RUN echo "cisco ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/cisco \
 && echo "admin ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/admin \
 && chmod 0440 /etc/sudoers.d/cisco \
 && chmod 0440 /etc/sudoers.d/admin

# =============================================================================
# 6. SSH Hardening for Lab Environments
# =============================================================================
RUN sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
 && sed -i 's/^#\?PermitRootLogin .*/PermitRootLogin no/' /etc/ssh/sshd_config

# =============================================================================
# 7. Start Environment
# =============================================================================
WORKDIR /home/admin
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
